# Optional — enables /api/send-report to actually deliver email via Resend.
# Without this, the endpoint logs the payload and returns a clear "not configured" error.
RESEND_API_KEY=

# Optional — sender address used when RESEND_API_KEY is set.
REPORT_FROM_EMAIL="ComplyCheck <reports@yourdomain.com>"

# Optional — enables Plausible Analytics. Leave blank to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
